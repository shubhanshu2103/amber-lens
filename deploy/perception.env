# Perception settings for the deployed server (no GPU, no Ollama). Load with env_file in docker-compose (#33).
# GROQ_API_KEY is a secret: set it in the server's own environment, never in this file or in git.
VISION_PROVIDER=groq
GROQ_MODEL=qwen/qwen3.8-27b
# No local fallback on the server: if Groq fails, every field is DISPUTED with reason vision_unavailable.
VISION_FALLBACK=none
