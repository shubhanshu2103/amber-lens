# Copy to .env and fill in. Never commit .env.
VISION_MODEL_API_KEY=
# Local vision model; qwen2.5vl:3b is faster but only for development, never for reported numbers.
VISION_MODEL_NAME=qwen2.5vl:7b
DATABASE_URL=sqlite:///./amber_lens.db
CONFIDENCE_REVIEW_THRESHOLD=0.80
# Root of the dataset (labels.csv, photos/tuning). Defaults to the read-only worktree of
# d/dataset-hf-40; switch to ./data once the final labels.csv lands on main.
AMBER_DATA_DIR=../amber-lens-data/data
# Local Ollama server for the vision model.
OLLAMA_HOST=http://localhost:11434
# On-disk cache of model responses, keyed by image hash, model and prompt version.
AMBER_CACHE_DIR=.cache/perception
# Vision provider: ollama (local, default) or groq (cloud; photos with a face are never sent).
VISION_PROVIDER=ollama
# Groq key goes in .env only, never in git.
GROQ_API_KEY=
# Groq preview model; may be deprecated at short notice.
GROQ_MODEL=qwen/qwen3.8-27b
# If the provider fails: none (every field DISPUTED, vision_unavailable) or ollama (try local first).
VISION_FALLBACK=none
